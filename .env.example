# Agora RTC + Conversational AI Engine — MANDATORY per hackathon rules (docs.agora.io/en/ai).
# App ID + App Certificate is Agora's *recommended* auth ("App Credentials" mode) — the official
# `agora-agents` SDK (apps/api/agora_conversational_ai.py) mints the ConvoAI token internally
# per request. Get these from console.agora.io > your project. See SETUP.md for the full walk.
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERT=your_agora_app_cert_here
AGORA_CERT=your_agora_app_cert_here
# Alternate auth mode (Customer ID/Secret, Console > Developer Toolkit > RESTful API) — the SDK
# supports this but our code doesn't use it; Agora's own docs call it "for testing only" and
# recommend App Credentials mode above instead. Kept here only in case you need it directly.
AGORA_CUSTOMER_ID=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# ASR/TTS default to Agora-managed vendors (Deepgram/MiniMax — no extra keys needed per the
# organizers). LLM defaults to "custom" so our own cognition engine (Claude) stays in the loop —
# see apps/api/agora_conversational_ai.py. AGORA_CUSTOM_LLM_URL is a BASE URL (no /chat/completions
# suffix — the SDK appends that itself) that must be publicly reachable, since Agora's servers
# call it over the internet — use ngrok or similar for local dev, e.g. https://xxxx.ngrok.io/agora
AGORA_CAI_ASR_MODE=managed
AGORA_CAI_TTS_MODE=managed
AGORA_CAI_LLM_MODE=custom
AGORA_CUSTOM_LLM_URL=https://your-public-api-url/agora
AGORA_CUSTOM_LLM_SHARED_SECRET=echosphere-internal

# Legacy/fallback STT — used only when Agora Conversational AI Engine isn't configured
# (STT_PROVIDER=deepgram|mock). Superseded by Agora CAI's managed ASR as the primary path.
STT_PROVIDER=mock
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM — LLM_PROVIDER=claude (PRD default) | openai | ollama. Auto-selects claude when
# ANTHROPIC_API_KEY is set, else openai when only OPENAI_API_KEY is set. Ollama needs no key
# so it must be requested explicitly.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_EXTRACT=claude-sonnet-5
ANTHROPIC_MODEL_SUMMARY=claude-opus-5
# Alternate provider (kept for environments without an Anthropic key)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Local provider — no API key, runs on your machine via `ollama serve` (default port 11434).
# Set LLM_PROVIDER=ollama to use this. Pull a model first: `ollama pull llama3.1:8b`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_EXTRACT=llama3.1:8b
OLLAMA_MODEL_SUMMARY=llama3.1:8b

# Tools — each adapter (apps/api/tools.py) switches from mock to a real HTTP call to that
# service the moment its credentials below are set. Leave any of them blank to keep that one
# mocked (logs only, no real ticket/message/page/annotation is created).
# Jira Cloud: JIRA_API_TOKEN from id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=your_jira_token
JIRA_PROJECT_KEY=PAY
# Slack: create an app at api.slack.com/apps, add chat:write scope, install to workspace,
# use the Bot User OAuth Token (starts xoxb-). Invite the bot to SLACK_CHANNEL first.
SLACK_TOKEN=xoxb-your-slack-token
SLACK_CHANNEL=#incidents
# PagerDuty: Events API v2 integration routing key (Service > Integrations > Add Integration
# > Events API v2) — NOT your account API key.
PAGERDUTY_KEY=your_pagerduty_events_v2_routing_key
# Datadog: DATADOG_API_KEY (org settings > API Keys) enables sending annotations/events;
# DATADOG_APP_KEY (org settings > Application Keys) additionally enables querying real metrics
# for PRD §9.1 monitoring verification (tools.query_datadog_metric). DATADOG_SITE defaults to
# datadoghq.com — use datadoghq.eu etc. if your org is on a different site.
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com

# TTS
TTS_PROVIDER=openai
# options: openai | elevenlabs | mock
ELEVENLABS_API_KEY=your_elevenlabs_key
TTS_VOICE=alloy

# Infra
DATABASE_URL=postgresql://agora:agora@postgres:5432/agora
REDIS_URL=redis://redis:6379/0
API_PORT=8000
WORKER_PORT=8001
WEB_PORT=5173
