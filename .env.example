# Agora RTC
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERT=your_agora_app_cert_here
AGORA_CERT=your_agora_app_cert_here
# REST API auth for Agora Conversational AI Engine + Signaling (Console > Developer Toolkit >
# RESTful API) — separate credential pair from AGORA_APP_ID/AGORA_APP_CERT above.
AGORA_CUSTOMER_ID=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# Agora Conversational AI Engine — MANDATORY per hackathon rules (docs.agora.io/en/ai).
# ASR/TTS default to Agora-managed vendors (Deepgram/MiniMax — no extra keys needed per the
# organizers). LLM defaults to "custom" so our own cognition engine (Claude) stays in the loop —
# see apps/api/agora_conversational_ai.py. AGORA_CUSTOM_LLM_URL must be a publicly reachable URL
# to this API's POST /agora/llm/chat/completions (use ngrok or similar for local dev).
AGORA_CAI_ASR_MODE=managed
AGORA_CAI_TTS_MODE=managed
AGORA_CAI_LLM_MODE=custom
AGORA_CUSTOM_LLM_URL=https://your-public-api-url/agora/llm/chat/completions

# Legacy/fallback STT — used only when Agora Conversational AI Engine isn't configured
# (STT_PROVIDER=deepgram|mock). Superseded by Agora CAI's managed ASR as the primary path.
STT_PROVIDER=mock
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM — LLM_PROVIDER=claude (PRD default) | openai. Auto-selects claude when
# ANTHROPIC_API_KEY is set, else openai when only OPENAI_API_KEY is set.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_EXTRACT=claude-sonnet-5
ANTHROPIC_MODEL_SUMMARY=claude-opus-5
# Alternate provider (kept for environments without an Anthropic key)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Tools (mock by default; set to enable live adapters)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=bot@example.com
JIRA_API_TOKEN=your_jira_token
SLACK_TOKEN=xoxb-your-slack-token
SLACK_CHANNEL=#incidents
PAGERDUTY_KEY=your_pagerduty_key
PAGERDUTY_SERVICE_ID=your_pd_service_id

# TTS
TTS_PROVIDER=openai
# options: openai | elevenlabs | mock
ELEVENLABS_API_KEY=your_elevenlabs_key
TTS_VOICE=alloy

# Infra
DATABASE_URL=postgresql://agora:agora@postgres:5432/agora
REDIS_URL=redis://redis:6379/0
API_PORT=8000
WORKER_PORT=8001
WEB_PORT=5173
